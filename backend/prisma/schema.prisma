generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" is the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Neon -pooler host) — used at runtime by the app.
  url      = env("DATABASE_URL")
  // Direct connection (non-pooled) — used by Prisma CLI for migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      UserProfile?
  mealLogs     MealLog[]
  workoutLogs  WorkoutLog[]
  waterLogs    WaterLog[]
  transactions Transaction[]
  goldEntries  GoldEntry[]
  summaries    DailySummary[]
  alarms       MotivationAlarm[]
  chatMessages ChatMessage[]
  memories     ChatMemory[]
  habits       Habit[]
  reports      ContentReport[]
}

// A tracked habit shown as one ring in the radial monthly tracker.
model Habit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  icon      String   @default("checkbox-outline")
  // manual | water | meals | workout | sleep | walking — drives auto-completion.
  source    String   @default("manual")
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
}

// One completion mark per habit per day. Absence = derive from the source data
// (for auto habits) or "not done" (for manual habits). A row here overrides.
model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      String
  done      Boolean  @default(true)
  // True when the app seeded it automatically (defaults / auto-tracking).
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  weightKg      Float    @default(70)
  heightCm      Float    @default(170)
  fitnessGoal   String   @default("Maintain")
  calorieTarget Int      @default(2200)
  waterGoalMl   Int      @default(2310)
  waterGoalMode String   @default("auto")
  monthlyBudget Float    @default(30000)
  // Daily-login streak persisted server-side so it survives reinstall/logout.
  streak         Int      @default(0)
  lastActiveDate String   @default("")
  // AI-assistant onboarding + derived plan.
  setupComplete  Boolean  @default(false)
  bmi            Float?
  sleepTime      String?
  gymTime        String?
  runningTime    String?
  fastingPlan    String   @default("none")
  // Meal + workout customization.
  // dietaryPreference: veg | eggetarian | nonveg | vegan — filters the meal catalog & AI suggestions.
  dietaryPreference String @default("veg")
  // Comma-separated foods the user wants left out of suggestions (e.g. "onion, garlic").
  avoidFoods        String @default("")
  // Default training preferences, persisted so they survive reinstall/logout.
  workoutMode       String @default("Home")     // Home | Gym
  workoutLevel      String @default("Beginner") // Beginner | Intermediate | Advanced
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealLog {
  id            String   @id @default(cuid())
  userId        String
  mealId        String
  mealName      String   @default("")
  mealType      String   @default("")
  quantity      Float
  date          String
  totalCalories Float
  totalProtein  Float
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model WorkoutLog {
  id             String   @id @default(cuid())
  userId         String
  date           String
  day            String
  exercises      String
  durationMin    Float
  caloriesBurned Float
  completed      Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One workout record per user per day — enforces "mark complete once a day".
  @@unique([userId, date])
}

model WaterLog {
  id           String   @id @default(cuid())
  userId       String
  date         String
  time         String
  amountMl     Float
  dailyTotalMl Float?
  goalMl       Float?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  txId      String
  type      String
  category  String
  amount    Float
  notes     String   @default("")
  date      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model GoldEntry {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  category  String
  grams     Float
  buyPrice  Float
  date      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailySummary {
  id                String   @id @default(cuid())
  userId            String
  date              String
  caloriesConsumed  Float
  caloriesBurned    Float
  netCalories       Float
  waterMl           Float
  waterGoalMl       Float
  spend             Float
  workoutCompleted  Boolean
  streak            Int
  completionPercent Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model MotivationAlarm {
  id        String   @id @default(cuid())
  userId    String
  // Client-generated id so the same alarm maps to one row across syncs.
  alarmId   String
  type      String
  hour      Int
  minute    Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alarmId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant | tool
  content   String
  // kind drives client rendering: text | cards | options | memory
  kind      String   @default("text")
  // Structured payload for cards/options/tool results.
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ChatMemory {
  id         String   @id @default(cuid())
  userId     String
  content    String
  category   String   @default("general")
  // Frequency-based promotion: candidate → saved at >= 3 occurrences.
  frequency  Int      @default(1)
  status     String   @default("candidate") // candidate | saved
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, content])
  @@index([userId, status])
}

// A user's report of an AI coach response they found offensive or harmful
// (required by Google Play's generative-AI policy). Deleted with the account.
model ContentReport {
  id        String   @id @default(cuid())
  userId    String
  messageId String?
  content   String
  reason    String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// One row per DELETED account: coarse, non-identifying usage aggregates kept for
// product analytics after the account and all its data are erased. Deliberately
// has NO user id, username, name, free text, money amounts, exact dates or exact
// body measurements — only counts, buckets and month-level dates, so it can't be
// linked back to a person.
model AnonymousUsageStat {
  id                   String   @id @default(cuid())
  signupMonth          String   // YYYY-MM
  deletedMonth         String   // YYYY-MM
  activeDays           Int      // distinct days with any log
  // Preferences (enumerated values only).
  fitnessGoal          String
  dietaryPreference    String
  workoutMode          String
  workoutLevel         String
  fastingPlan          String
  bmiBucket            String   // underweight | normal | overweight | obese | unknown
  setupComplete        Boolean
  // Feature usage counts.
  mealLogs             Int
  workoutLogs          Int
  workoutsCompleted    Int
  workoutMinutes       Int
  waterLogs            Int
  transactions         Int
  goldEntries          Int
  habits               Int
  habitCompletions     Int
  coachMessagesSent    Int
  coachMemories        Int
  coachAlarms          Int
  maxStreak            Int
  avgCompletionPercent Float?
  createdAt            DateTime @default(now())

  @@index([deletedMonth])
}
