# ─── Server ───────────────────────────────────────────────────────────────────
# Port to listen on
PORT=3001

# Comma-separated allowed CORS origins (leave empty to allow all in dev)
# Example for production: ALLOWED_ORIGINS=https://your-expo-app.com
ALLOWED_ORIGINS=

# ─── Google OAuth (Installed / Desktop client) ───────────────────────────────
# Source: Google Cloud Console → Credentials → OAuth 2.0 Clients → Desktop client
# Also: client_secret.json → installed.client_id
#
# The backend is a pass-through API — it receives the user's Google OAuth Bearer
# token from the frontend and uses it to call Google Sheets. These credentials
# are NOT required for normal operation but are useful for:
#   • Future token introspection / revocation
#   • Running admin scripts that need server-side OAuth
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=

# ─── AI Coach (optional) ──────────────────────────────────────────────────────
# Groq Cloud API key for generating personalized motivation-call messages
# (POST /api/motivation). Get one at https://console.groq.com/keys. When unset,
# the API serves messages from a built-in bank instead — the feature still works.
# (Variable name kept as ANTHROPIC_API_KEY for backwards compatibility.)
ANTHROPIC_API_KEY=

# Optional: override the Groq model used for the AI coach.
# Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# ─── Legal / Play Store ──────────────────────────────────────────────────────
# Public contact shown in the Privacy Policy, Terms and account-deletion page
# (/api/legal/privacy, /api/legal/terms, /api/legal/delete-account).
# Defaults to gunjalnavnath50@gmail.com (set in src/legal/content.ts); set this
# only to override it for a deployment.
SUPPORT_EMAIL=
