{
  "expo": {
    "name": "SyncLife",
    "slug": "synclife",
    "scheme": "synclife",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0A0A0A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.synclife.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm_classic.wav",
            "./assets/sounds/alarm_gentle.wav",
            "./assets/sounds/alarm_digital.wav"
          ]
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SyncLife uses the microphone so you can talk back to your AI coach on a call.",
          "speechRecognitionPermission": "SyncLife uses speech recognition to understand your replies during coach calls."
        }
      ]
    ],
    "owner": "sidharth_gunjal",
    "extra": {
      "eas": {
        "projectId": "0d4a3a8d-44e1-4740-992d-c1282edcf890"
      }
    }
  }
}
