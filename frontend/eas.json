{
  "cli": {
    "version": ">=18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://synclifebackend.vercel.app"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://synclifebackend.vercel.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {}
    }
  }
}
