    "@tanstack/react-query": "^5.51.23",
    "expo": "~54.0.4",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
