{
  "name": "synclife",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "phone": "expo start --lan --port 8090",
    "phone:tunnel": "expo start --tunnel --port 8090",
    "android": "expo run:android",
    "android:tunnel": "expo start --tunnel",
    "android:dev-client": "expo start --dev-client --android",
    "eas:credentials": "eas credentials -p android",
    "eas:build:dev": "eas build -p android --profile development",
    "eas:build:preview": "eas build -p android --profile preview",
    "eas:build:production": "eas build -p android --profile production",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.51.23",
    "expo": "~51.0.39",
    "expo-auth-session": "~5.5.2",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.10",
    "expo-notifications": "~0.28.19",
    "expo-speech": "~12.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-web-browser": "~13.0.3",
    "firebase": "^10.13.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-toast-message": "^2.2.0",
    "victory-native": "36.9.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~18.2.79",
    "metro": "^0.80.12",
    "typescript": "~5.3.3"
